{
  "name": "kolomyia-elder-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --watch",
    "enrich": "tsx tools/enrich-buildings.ts",
    "lint": "biome check --error-on-warnings --diagnostic-level=warn",
    "preview": "vite preview",
    "deploy": "tsc && vite build && gh-pages -d dist",
    "postinstall": "patch-package",
    "upgrade": "npx npm-check-updates --upgrade && npm install"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "leaflet-hash": "^0.2.1",
    "leaflet-providers": "^4.0.0",
    "maplibre-gl": "^6.9.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-string-replace": "^2.0.1",
    "reactjs-popup": "^2.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "gh-pages": "6.3.0",
    "patch-package": "^8.0.1",
    "rollup-plugin-license": "^3.7.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "overrides": {
    "esbuild@<0.28.1": "0.28.1"
  }
}
